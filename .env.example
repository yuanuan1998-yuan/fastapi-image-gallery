# 复制本文件为 .env 并填入真实值（.env 不要提交到仓库）
# 在 Bitiful 控制台「anyfast 存储桶 → S3 兼容接入 / 密钥管理」页面可获取这些值

# 是否启用对象存储：true 上传到 S3，false 用本地 uploads/
OSS_ENABLED=false

# S3 接入点：缤纷云官方为 https://s3.bitiful.net
# （注意是 .net！https://s3.bitiful.com 这个域名根本不存在，连不上）
OSS_ENDPOINT=https://s3.bitiful.net

# 密钥（AccessKeyId / SecretAccessKey）—— 必须是一对，来自同一条密钥记录
OSS_ACCESS_KEY_ID=__YOUR_ACCESS_KEY_ID__
OSS_SECRET_ACCESS_KEY=__YOUR_SECRET_ACCESS_KEY__

# 存储桶名称
OSS_BUCKET=anyfast
# 区域：缤纷云官方示例为 cn-east-1
OSS_REGION=cn-east-1
# 公网访问域名：https://<桶名>.s3.bitiful.net（以控制台「外链/访问域名」为准）
OSS_PUBLIC_BASE=https://anyfast.s3.bitiful.net

# 对象 key 前缀（与本地旧数据 /static/ 区分）；寻址风格 path/virtual/auto
OSS_KEY_PREFIX=images/
OSS_ADDRESSING=path
