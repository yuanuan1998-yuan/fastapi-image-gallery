[Unit]
Description=Personal Image Gallery FastAPI
After=network.target mysql.service

[Service]
# 改成你实际登录用户名与项目路径（下面示例假设项目放在 /home/ubuntu/gallery）
User=ubuntu
WorkingDirectory=/home/ubuntu/gallery
Environment=DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/my_image_list?charset=utf8
ExecStart=/home/ubuntu/gallery/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
